{
  // standalone (non-composite) on purpose: the playground consumes the package straight from
  // source via the `@/` and `vue-maplibre-gl` aliases, which project references cannot express
  // without an emitted dist. It is a dev artifact and not part of the build graph.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vite/client", "node"],
    "paths": {
      // the package is type-checked from source here, so its internal aliases have to resolve too;
      // mirrors packages/vue-maplibre-gl/tsconfig.src.json
      "components": ["../packages/vue-maplibre-gl/src/components/index.ts"],
      "components/*": ["../packages/vue-maplibre-gl/src/components/*"],
      "composable/*": ["../packages/vue-maplibre-gl/src/composable/*"],
      "css/*": ["../packages/vue-maplibre-gl/src/css/*"],
      "lib/*": ["../packages/vue-maplibre-gl/src/lib/*"],
      "plugins/*": ["../packages/vue-maplibre-gl/src/plugins/*"],
      "types": ["../packages/vue-maplibre-gl/src/types/index.ts"],
      "types/*": ["../packages/vue-maplibre-gl/src/types/*"],
      "@/*": ["../packages/vue-maplibre-gl/src/*"],
      "vue-maplibre-gl": ["../packages/vue-maplibre-gl/src/index.ts"],
      "vue-maplibre-gl/draw": ["../packages/vue-maplibre-gl/src/plugins/draw/index.ts"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.vue", "../packages/vue-maplibre-gl/src/**/*.ts", "../packages/vue-maplibre-gl/src/**/*.vue"],
  "exclude": ["dist"]
}
