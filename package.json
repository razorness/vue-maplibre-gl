{
  "name": "vue-maplibre-gl-monorepo",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/razorness/vue-maplibre-gl.git"
  },
  "scripts": {
    "build": "pnpm --filter vue-maplibre-gl build",
    "dev": "pnpm --filter playground dev",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint && pnpm format:check && pnpm lint:padding",
    "lint:oxlint": "oxlint --type-aware",
    "lint:eslint": "eslint .",
    "lint:fix": "oxlint --type-aware --fix && eslint . --fix && pnpm format",
    "test": "pnpm --filter vue-maplibre-gl test",
    "test:coverage": "pnpm --filter vue-maplibre-gl test:coverage",
    "docs:dev": "pnpm --filter docs dev",
    "docs:build": "pnpm --filter docs build",
    "upgrade": "npx taze major -I -r",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:padding": "node scripts/check-padded-blocks.mjs"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.1.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.75.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "jiti": "^2.7.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vue-tsc": "^3.3.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@11.17.0"
}
